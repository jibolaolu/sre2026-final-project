OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1-mini

# Anthropic Claude (used as fallback when OpenAI fails, or as the sole provider
# if OPENAI_API_KEY is absent).  Get a key from console.anthropic.com.
# ANTHROPIC_MODEL defaults to claude-haiku-5-5 (fast); use claude-opus-5-5 for
# more advanced reasoning.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-haiku-5-5

# Redis conversation memory (defaults to the banking-net redis container)
REDIS_URL=redis://redis:6379
SESSION_TTL_SECONDS=1800
